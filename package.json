{
  "name": "dpo-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de Protección de Datos - arquitectura de microservicios (backend) y módulos independientes (frontend)",
  "workspaces": [
    "shared/*",
    "services/*",
    "frontend/shell",
    "frontend/modules/*"
  ],
  "scripts": {
    "build:common": "npm run build --workspace=shared/common",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "db:migrate": "node scripts/migrate.js",
    "postinstall": "npm run build --workspace=shared/common"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  }
}
