# ==========================================================================
# Variables de entorno - Plataforma DPO
# Copiar a .env y completar con los valores reales (nunca commitear .env)
# ==========================================================================

# --- PostgreSQL (Hostinger o local via docker-compose) -----------------
# Host de PostgreSQL en Hostinger, ej: srv1234.hstgr.io
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dpo_platform
POSTGRES_USER=dpo_admin
POSTGRES_PASSWORD=change_me
# SSL suele ser obligatorio en Hostinger managed Postgres
POSTGRES_SSL=false

# Cadena de conexión completa (si se define, tiene prioridad sobre los campos anteriores)
# DATABASE_URL=postgres://dpo_admin:change_me@srv1234.hstgr.io:5432/dpo_platform

# --- Seguridad -----------------------------------------------------------
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=8h

# --- Puertos de servicios (uso local / docker-compose) --------------------
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CONSENT_SERVICE_PORT=3002
RAT_SERVICE_PORT=3003
ARCO_SERVICE_PORT=3004
BREACH_SERVICE_PORT=3005
RETENTION_SERVICE_PORT=3006
ETHICS_SERVICE_PORT=3007
MATURITY_SERVICE_PORT=3008
TRAINING_SERVICE_PORT=3009
CONTRACTS_SERVICE_PORT=3010
AUDIT_SERVICE_PORT=3011
EVIDENCE_SERVICE_PORT=3012

# --- URLs internas usadas por el gateway para enrutar hacia cada servicio -
# (Solo aplica si corres los servicios sueltos con `node .../main.js`.
#  docker-compose.yml ya trae estas URLs apuntando a los nombres de los
#  contenedores — no hace falta tocarlas ahí.)
AUTH_SERVICE_URL=http://localhost:3001
CONSENT_SERVICE_URL=http://localhost:3002
RAT_SERVICE_URL=http://localhost:3003
ARCO_SERVICE_URL=http://localhost:3004
BREACH_SERVICE_URL=http://localhost:3005
RETENTION_SERVICE_URL=http://localhost:3006
ETHICS_SERVICE_URL=http://localhost:3007
MATURITY_SERVICE_URL=http://localhost:3008
TRAINING_SERVICE_URL=http://localhost:3009
CONTRACTS_SERVICE_URL=http://localhost:3010
AUDIT_SERVICE_URL=http://localhost:3011
EVIDENCE_SERVICE_URL=http://localhost:3012

# --- Despliegue con docker-compose en un servidor remoto (VPS Hostinger) --
# IP pública (o dominio) del servidor. Usada SOLO al construir la imagen
# del "shell": Vite incrusta esta URL en el bundle del navegador, así que
# debe ser una dirección alcanzable por el navegador del usuario final,
# NUNCA "localhost" ni el nombre de un contenedor Docker.
# Ejemplo: PUBLIC_HOST=123.45.67.89  (o PUBLIC_HOST=app.midominio.com)
PUBLIC_HOST=localhost
